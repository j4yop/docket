# Clocked key. Server-side only. Never expose this to the browser.
CLOCKED_API_KEY=

# Optional Clocked base URL
CLOCKED_BASE_URL=https://clocked.rezolve.ai/clocked

# Signed browser sessions for /api/check, /api/check/stream and /api/ablate
DOCKET_SESSION_SECRET=
DOCKET_SESSION_LIMIT_PER_HOUR=60

# Policy envelope signing. Falls back to DOCKET_SESSION_SECRET.
DOCKET_POLICY_SECRET=

# Admin-only routes: GET /api/checks, POST /api/policies/approve,
# GET /api/reviews, POST /api/reviews/{id}/assign, POST /api/reviews/{id}/resolve
DOCKET_ADMIN_TOKEN=

# Durable audit and policy registry.
# Set automatically by Vercel when a Blob store is connected. Without it,
# Docket writes the same chain to .docket-store/ and labels it local.
BLOB_READ_WRITE_TOKEN=
# DOCKET_STORE_DIR=.docket-store

# Per-instance SQLite hot index (not the audit system of record)
DOCKET_DB=./docket.db

# Streaming stage events
DOCKET_STREAMING=1

# Public demo guardrails
DOCKET_RATE_LIMIT_PER_HOUR=60
DOCKET_DAILY_CHECK_CAP=200

# Optional bearer token for direct API integrations
DOCKET_API_TOKEN=

# Guard / Inspect operating thresholds.
# Guard stays at 0.50: the calibration corpus cannot separate the thresholds.
# Inspect is 0.10: the calibration gap runs from 0.008 (highest safe) to
# 0.188 (lowest unsafe). Re-run the calibration suite before changing either.
DOCKET_GUARD_THRESHOLD=0.50
DOCKET_INSPECT_THRESHOLD=0.10
